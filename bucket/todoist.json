{
    "version": "9.36.2",
    "description": "Todoist desktop app for Windows",
    "homepage": "https://todoist.com/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://todoist.com/terms-of-service"
    },
    "##": "The NSIS setup contains an app-*.7z bundle; unpack it into Scoop's managed directory.",
    "architecture": {
        "64bit": {
            "url": "https://electron-dl.todoist.net/windows/Todoist-win32-9.36.2-x64-latest.exe#/dl.7z",
            "hash": "2ca2d3e51c750eb0c3ee56195ceb6b3a0b94dfc7fda95add4ba44fb0739617c8"
        },
        "arm64": {
            "url": "https://electron-dl.todoist.net/windows/Todoist-win32-9.36.2-arm64-latest.exe#/dl.7z",
            "hash": "e6d91eb6cd76fbefc3f8900c791d989aea3acfb62e173aeaf5c78f808eadf6e1"
        }
    },
    "pre_install": [
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-*.7z\" \"$dir\"",
        "if (!(Test-Path -LiteralPath (Join-Path $dir 'Todoist.exe'))) { throw 'Todoist.exe was not found after extraction.' }",
        "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Force -Recurse"
    ],
    "shortcuts": [
        [
            "Todoist.exe",
            "Todoist"
        ]
    ],
    "checkver": {
        "script": [
            "$request = [System.Net.HttpWebRequest]::Create('https://todoist.com/windows_app')",
            "$request.Method = 'HEAD'",
            "$response = $request.GetResponse()",
            "try { $response.ResponseUri.AbsoluteUri } finally { $response.Close() }"
        ],
        "regex": "Todoist-win32-(?<version>[\\d.]+)(?:-x64)?-latest\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://electron-dl.todoist.net/windows/Todoist-win32-$version-x64-latest.exe#/dl.7z",
                "hash": {
                    "mode": "download"
                }
            },
            "arm64": {
                "url": "https://electron-dl.todoist.net/windows/Todoist-win32-$version-arm64-latest.exe#/dl.7z",
                "hash": {
                    "mode": "download"
                }
            }
        }
    }
}
